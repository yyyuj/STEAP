Bootstrap: library
From: ubuntu:20.04

%files
    ../steap_container_sif/container_env.sh /etc/steap/container_env.sh

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y \
        wget \
        git \
        git-lfs \
        build-essential \
        libssl-dev \
        libffi-dev \
        python3 \
        python3-pip \
        python3-dev \
        openjdk-11-jdk \
        rsync

    git-lfs install

    # Miniconda: base install + STEAP/munge_ldsc envs via install.sh
    wget -q "https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh" -O /tmp/miniconda.sh
    bash /tmp/miniconda.sh -b -p /opt/miniconda
    rm /tmp/miniconda.sh
    export PATH=/opt/miniconda/bin:$PATH

    git clone https://github.com/ComPopBio/STEAP.git /STEAP
    bash /STEAP/install.sh
    mkdir -p /STEAP/out /STEAP/gwas /STEAP/.snakemake

    # Fixed prefix for Snakemake rule environments (baked into image, read-only at runtime)
    export STEAP_CONDA_PREFIX=/opt/snakemake-conda
    mkdir -p "${STEAP_CONDA_PREFIX}"

    # shellcheck disable=SC1091
    . /opt/miniconda/etc/profile.d/conda.sh
    conda activate steap

    cd /STEAP
    for snakefile in cellect-ldsc.snakefile cellect-magma.snakefile cellect-h-magma.snakefile; do
        echo "Pre-creating Snakemake conda envs from ${snakefile}..."
        snakemake --conda-create-envs-only \
            --use-conda \
            --conda-prefix "${STEAP_CONDA_PREFIX}" \
            -s "${snakefile}" \
            --configfile config/config.yml
    done

    chmod 755 /etc/steap/container_env.sh
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%environment
    export PATH=/opt/miniconda/envs/steap/bin:/opt/miniconda/bin:$PATH
    export STEAP_CONDA_PREFIX=/opt/snakemake-conda
    export STEAP_ROOT=/STEAP
    export CONDA_DEFAULT_ENV=steap
    export CONDA_PREFIX=/opt/miniconda/envs/steap

%runscript
    echo "STEAP Singularity container"
    echo "  steap env:     /opt/miniconda/envs/steap"
    echo "  munge_ldsc:    /opt/miniconda/envs/munge_ldsc"
    echo "  rule envs:     /opt/snakemake-conda"
    echo ""
    echo "Run enrichment analysis:"
    echo "  bash steap_container_sif/setup_host_dirs.sh"
    echo "  bash steap_container_sif/cell_type_sif.sh"
    echo ""
    echo "Documentation:"
    echo "  steap_container_sif/README.md"
    echo "  README.md"

%test
    # shellcheck disable=SC1091
    . /opt/miniconda/etc/profile.d/conda.sh

    echo "=== OS ==="
    grep PRETTY_NAME /etc/os-release

    echo "=== Conda envs ==="
    conda env list

    echo "=== steap Python ==="
    conda activate steap
    python --version
    snakemake --version

    echo "=== munge_ldsc Python ==="
    conda activate munge_ldsc
    python --version

    echo "=== Snakemake rule conda envs ==="
    test -d /opt/snakemake-conda
    test "$(ls -A /opt/snakemake-conda)" || (echo "ERROR: no envs in /opt/snakemake-conda" && exit 1)
    ls /opt/snakemake-conda

    echo "=== container_env.sh ==="
    test -f /etc/steap/container_env.sh

%labels
    Author "Jing Yu"
    Version "2.0"
    Description "STEAP pipeline container with pre-built conda and Snakemake environments"

%help
    STEAP (Single cell Type Enrichment Analysis for Phenotypes)

    Pre-installed:
      - steap conda env (Snakemake orchestration, Python 3.9)
      - munge_ldsc conda env (GWAS munging, Python 2)
      - Snakemake rule envs at /opt/snakemake-conda (cellectpy3, cellectpy27)

    Quick start on the host:
      1. bash steap_container_sif/setup_host_dirs.sh
      2. Edit $HOME/STEAP/config/config.yml, add GWAS files to $HOME/STEAP/gwas
      3. bash steap_container_sif/cell_type_sif.sh

    Bind mounts (handled by wrapper scripts):
      - gwas, out, config, .snakemake (metadata only; conda envs are in the image)

    Build instructions:
      build_steap_container/build_steap_singularity_steps.txt

    User guide:
      steap_container_sif/README.md
      README.md
